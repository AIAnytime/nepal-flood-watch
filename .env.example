# ─── Primary LLM provider (any OpenAI-compatible endpoint) ────────────────────
# Powers the risk outlook, news digest, fact-checker, public Q&A and the
# moderation pass on submitted reports.
LLM_API_KEY=
LLM_BASE_URL=https://api.aicredits.in/v1

# Chosen by measurement, not sticker price. gpt-5-nano looks cheaper per token but
# is a reasoning model: on a representative extraction prompt it spent 6,655 output
# tokens where Flash Lite spent 199 — ~30x dearer in practice — and it invented a
# figure on a prompt that forbids it. Flash Lite also handles Devanagari better,
# which matters for the Nepali and Hindi pages. Roughly $0.09 per 1,000 calls.
LLM_MODEL=google/gemini-2.5-flash-lite

# Optional. Defaults to LLM_MODEL. Used for report screening, which runs on every
# submission and is a classification task rather than an analysis one.
LLM_MODEL_FAST=

# Fact-checking needs live web search — a claim circulating today cannot be checked
# against training data. Must be a search-capable model.
LLM_MODEL_GROUNDED=perplexity/sonar

# ─── Fallback provider ────────────────────────────────────────────────────────
# Groq's free tier, used automatically when the primary is missing, rate-limited or
# erroring. Free key: https://console.groq.com/keys
# Note the free tier is 8,000 tokens/minute, so it is a safety net, not a workhorse.
GROQ_API_KEY=

# With neither provider set the site still works: live river, rainfall, hazard and
# news data all render, and the report form holds submissions for review instead of
# screening them.

# ─── Public reports storage ───────────────────────────────────────────────────
# Turso. Without it, local dev writes to .data/reports.db and a deployed instance
# keeps reports in memory only (lost on redeploy).
#   turso db create nepal-flood-watch
#   turso db show nepal-flood-watch --url
#   turso db tokens create nepal-flood-watch
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Misc ─────────────────────────────────────────────────────────────────────
# Salt for hashing submitter IPs used in rate limiting. Raw IPs are never stored.
# Set this to any long random string in production.
IP_HASH_SALT=

# Canonical origin, used for sitemap, hreflang, canonical tags and OG URLs.
# Set this to your real domain in production or the SEO metadata will point at the
# placeholder.
NEXT_PUBLIC_SITE_URL=
